# Autonomy Gate runs fully without either key: the deterministic engine owns every
# autonomy outcome, and a test asserts the result is identical with both layers
# removed. These only enable the optional model-backed layers.

# Bounded classification of ambiguous reviewer evidence.
# Absent -> seeded prototype responses are used, and the About panel says so.
TYPESAFE_API_KEY=

# Plain-language rephrasing of an already-final decision.
# Absent -> the deterministic "Standard summary" is shown instead.
GROQ_API_KEY=

# Optional: overrides the default small model if that one is unavailable.
GROQ_MODEL=
